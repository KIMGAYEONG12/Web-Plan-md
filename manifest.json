{
  "manifest_version": 3,

  "name": "WebToDo",

  "short_name": "WebToDo",

  "version": "2.1.0",

  "description": "웹페이지 TODO + 형광펜 저장 확장프로그램",

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "tabs",
    "sidePanel",
    "downloads"
  ],

  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",

    "default_title": "WebToDo",

    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "side_panel": {
    "default_path": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],

      "js": ["content.js"],

      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["icons/*"],

      "matches": ["<all_urls>"]
    }
  ],

  "icons": {
    "16": "icons/icon16.png",

    "48": "icons/icon48.png",

    "128": "icons/icon128.png"
  },

  "minimum_chrome_version": "114"
}
